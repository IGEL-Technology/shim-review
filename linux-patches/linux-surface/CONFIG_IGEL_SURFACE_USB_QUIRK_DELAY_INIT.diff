IGEL_SURFACE_USB_QUIRK_DELAY_INIT
	  The touchpad on the Type-Cover of the Surface Go 3 is sometimes not
	  being initialized properly. Add delay init to fix this issue.

	  Source: linux-surface
	  URL: https://github.com/linux-surface/linux-surface/tree/master/patches
diff --git a/drivers/usb/core/quirks.c b/drivers/usb/core/quirks.c
index 21f9b7fec8cb..4631fc20defc 100644
--- a/drivers/usb/core/quirks.c
@@ -229,6 +229,11 @@ static const struct usb_device_id usb_quirk_list[] = {
 	/* Microsoft Surface Dock Ethernet (RTL8153 GigE) */
 	{ USB_DEVICE(0x045e, 0x07c6), .driver_info = USB_QUIRK_NO_LPM },
 
+#ifdef CONFIG_IGEL_SURFACE_USB_QUIRK_DELAY_INIT
+	/* Microsoft Surface Go 3 Type-Cover */
+	{ USB_DEVICE(0x045e, 0x09b5), .driver_info = USB_QUIRK_DELAY_INIT },
+#endif /* CONFIG_IGEL_SURFACE_USB_QUIRK_DELAY_INIT */
+
 	/* Cherry Stream G230 2.0 (G85-231) and 3.0 (G85-232) */
 	{ USB_DEVICE(0x046a, 0x0023), .driver_info = USB_QUIRK_RESET_RESUME },
 
