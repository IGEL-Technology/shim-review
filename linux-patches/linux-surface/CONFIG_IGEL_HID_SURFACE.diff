IGEL_HID_SURFACE
	  Say Y here to enable HID driver for Microsoft Surface integrated
	  keyboard and touchpad. This driver filters out erroneous BTN_0
	  (FN key) events that can cause input focus issues.

	  Source: linux-surface
	  URL: https://github.com/linux-surface/linux-surface/tree/master/patches
diff --git a/drivers/hid/Makefile b/drivers/hid/Makefile
index 361a7daedeb8..7979a081733d 100644
--- a/drivers/hid/Makefile
@@ -174,5 +177,7 @@ obj-$(CONFIG_INTEL_ISH_HID)	+= intel-ish-hid/
 obj-$(CONFIG_AMD_SFH_HID)       += amd-sfh-hid/
 
 obj-$(CONFIG_SURFACE_HID_CORE)  += surface-hid/
+obj-$(CONFIG_IGEL_HID_SURFACE)	+= hid-surface.o
 
 obj-$(CONFIG_INTEL_THC_HID)     += intel-thc-hid/
+obj-$(CONFIG_IGEL_SURFACE_HID_IPTS)     += ipts/
