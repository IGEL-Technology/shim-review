IGEL_SURFACE_CAMERA_LEDS_TPS68470
	  This driver supports TPS68470 PMIC with LED chip.
	  It provides two LED controllers, with the ability to drive 2
	  indicator LEDs and 2 flash LEDs.

	  To compile this driver as a module, choose M and it will be
	  called leds-tps68470

	  Source: linux-surface
	  URL: https://github.com/linux-surface/linux-surface/tree/master/patches
diff --git a/drivers/leds/Makefile b/drivers/leds/Makefile
index 9a0333ec1a86..c9add557fe61 100644
--- a/drivers/leds/Makefile
@@ -93,6 +93,7 @@ obj-$(CONFIG_LEDS_TCA6507)		+= leds-tca6507.o
 obj-$(CONFIG_LEDS_TI_LMU_COMMON)	+= leds-ti-lmu-common.o
 obj-$(CONFIG_LEDS_TLC591XX)		+= leds-tlc591xx.o
 obj-$(CONFIG_LEDS_TPS6105X)		+= leds-tps6105x.o
+obj-$(CONFIG_IGEL_SURFACE_CAMERA_LEDS_TPS68470)            += leds-tps68470.o
 obj-$(CONFIG_LEDS_TURRIS_OMNIA)		+= leds-turris-omnia.o
 obj-$(CONFIG_LEDS_UPBOARD)		+= leds-upboard.o
 obj-$(CONFIG_LEDS_WM831X_STATUS)	+= leds-wm831x-status.o
