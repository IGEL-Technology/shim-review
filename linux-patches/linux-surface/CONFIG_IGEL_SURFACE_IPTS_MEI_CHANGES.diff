IGEL_SURFACE_IPTS_MEI_CHANGES
	  This will enable a intel mei me change to support IPTS devices so
	  if you plan to use touch on microsoft surface devices you need to
	  enable this. The ipts.ko itself is not in thirdparty modules for
	  easier maintain and update it.

	  Source: linux-surface
	  URL: https://github.com/linux-surface/linux-surface/tree/master/patches
diff --git a/drivers/iommu/intel/iommu.c b/drivers/iommu/intel/iommu.c
index 79676188f60f..558bb44c90c7 100644
--- a/drivers/iommu/intel/iommu.c
@@ -39,6 +39,22 @@
 #define IS_ISA_DEVICE(pdev) ((pdev->class >> 8) == PCI_CLASS_BRIDGE_ISA)
 #define IS_AZALIA(pdev) ((pdev)->vendor == 0x8086 && (pdev)->device == 0x3a3e)
 
+#ifdef CONFIG_IGEL_SURFACE_IPTS_MEI_CHANGES
+#define IS_IPTS(pdev) ( \
+		((pdev)->vendor == PCI_VENDOR_ID_INTEL && (pdev)->device == 0x9D3E) || \
+		((pdev)->vendor == PCI_VENDOR_ID_INTEL && (pdev)->device == 0x34E4) \
+	)
+#endif /* CONFIG_IGEL_SURFACE_IPTS_MEI_CHANGES */
+
+#ifdef CONFIG_IGEL_SURFACE_IMPROVE_CAMERA_SUPPORT
+#define IS_INTEL_IPU(pdev) ((pdev)->vendor == PCI_VENDOR_ID_INTEL &&	\
+			   ((pdev)->device == 0x9a19 ||		\
+			    (pdev)->device == 0x9a39 ||		\
+			    (pdev)->device == 0x4e19 ||		\
+			    (pdev)->device == 0x465d ||		\
+			    (pdev)->device == 0x1919))
+#endif /* CONFIG_IGEL_SURFACE_IMPROVE_CAMERA_SUPPORT */
+
 #define IOAPIC_RANGE_START	(0xfee00000)
 #define IOAPIC_RANGE_END	(0xfeefffff)
 #define IOVA_START_ADDR		(0x1000)
