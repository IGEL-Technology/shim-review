IGEL_ADD_SUPPORT_FOR_MEDIATEK_MT7927
	  Add support for mt7927 (backport) into the kernel.

	  Source: External
	  https://github.com/jetm/mediatek-mt7927-dkms
diff --git a/drivers/net/wireless/mediatek/mt76/mt76_connac.h b/drivers/net/wireless/mediatek/mt76/mt76_connac.h
index 192dcc374a64..a44fc91dc19f 100644
--- a/drivers/net/wireless/mediatek/mt76/mt76_connac.h
@@ -172,25 +172,57 @@ struct mt76_connac_tx_free {
 
 extern const struct wiphy_wowlan_support mt76_connac_wowlan_support;
 
+#ifdef CONFIG_IGEL_ADD_SUPPORT_FOR_MEDIATEK_MT7927
+static inline bool is_mt7925(struct mt76_dev *dev)
+{
+	return mt76_chip(dev) == 0x7925 || mt76_chip(dev) == 0x7927;
+}
+
+static inline bool is_mt7927(struct mt76_dev *dev)
+{
+	return mt76_chip(dev) == 0x7927;
+}
+
+static inline bool is_320mhz_supported(struct mt76_dev *dev)
+{
+	return is_mt7927(dev);
+}
+#else
 static inline bool is_mt7925(struct mt76_dev *dev)
 {
 	return mt76_chip(dev) == 0x7925;
 }
+#endif
 
 static inline bool is_mt7920(struct mt76_dev *dev)
 {
 	return mt76_chip(dev) == 0x7920;
 }
 
+#ifdef CONFIG_IGEL_ADD_SUPPORT_FOR_MEDIATEK_MT7902
+static inline bool is_mt7902(struct mt76_dev *dev)
+{
+	return mt76_chip(dev) == 0x7902;
+}
+#endif
+
 static inline bool is_mt7922(struct mt76_dev *dev)
 {
 	return mt76_chip(dev) == 0x7922;
 }
 
+#ifdef CONFIG_IGEL_ADD_SUPPORT_FOR_MEDIATEK_MT7902
+static inline bool is_connac2(struct mt76_dev *dev)
+{
+	return mt76_chip(dev) == 0x7961 || is_mt7922(dev) || is_mt7920(dev) ||
+				is_mt7902(dev);
+}
+#else
 static inline bool is_mt7921(struct mt76_dev *dev)
 {
 	return mt76_chip(dev) == 0x7961 || is_mt7922(dev) || is_mt7920(dev);
 }
+#endif
 
