 		 */
 		if (!(walk_state->op_info->flags & AML_NO_OPERAND_RESOLVE) &&
+#ifdef CONFIG_IGEL_APPLE_ACPI
+			walk_state->num_operands > 0) {
+#else
 		    (walk_state->op_info->flags & AML_HAS_ARGS)) {
+#endif
 
 			/* Resolve all operands */
 
