+			      u32 dev_id)
+#else
 int btmtk_setup_firmware_79xx(struct hci_dev *hdev, const char *fwname,
 			      wmt_cmd_sync_func_t wmt_cmd_sync)
+#endif
 {
 	struct btmtk_hci_wmt_params wmt_params;
