 }
 EXPORT_SYMBOL_GPL(btmtk_fw_get_filename);
 
+#ifdef CONFIG_IGEL_ADD_SUPPORT_FOR_MT6639
+int btmtk_setup_firmware_79xx(struct hci_dev *hdev, const char *fwname,
