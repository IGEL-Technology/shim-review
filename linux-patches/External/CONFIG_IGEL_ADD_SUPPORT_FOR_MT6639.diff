--- a/drivers/bluetooth/btmtk.c
@@ -166,6 +198,16 @@ int btmtk_setup_firmware_79xx(struct hci_dev *hdev, const char *fwname,
 		section_offset = le32_to_cpu(sectionmap->secoffset);
 		dl_size = le32_to_cpu(sectionmap->bin_info_spec.dlsize);
 
+#ifdef CONFIG_IGEL_ADD_SUPPORT_FOR_MT6639
+		/* MT6639: only download sections where dlmode byte0 == 0x01,
+		 * matching the Windows driver behavior which skips WiFi/other
+		 * sections that would cause the chip to hang.
+		 */
+		if (dev_id == 0x6639 && dl_size > 0 &&
+		    (le32_to_cpu(sectionmap->bin_info_spec.dlmodecrctype) & 0xff) != 0x01)
+			continue;
+#endif
+
 		if (dl_size > 0) {
 			retry = 20;
 			while (retry > 0) {
diff --git a/drivers/bluetooth/btmtk.c b/drivers/bluetooth/btmtk.c
index 38ba8f2bd2f9..c30bdf7befc3 100644
--- a/drivers/bluetooth/btmtk.c
@@ -853,7 +895,11 @@ int btmtk_usb_subsys_reset(struct hci_dev *hdev, u32 dev_id)
 		if (err < 0)
 			return err;
 		msleep(100);
+#ifdef CONFIG_IGEL_ADD_SUPPORT_FOR_MT6639
+	} else if (dev_id == 0x7925 || dev_id == 0x6639) {
+#else
 	} else if (dev_id == 0x7925) {
+#endif
 		err = btmtk_usb_uhw_reg_read(hdev, MTK_BT_RESET_REG_CONNV3, &val);
 		if (err < 0)
 			return err;
diff --git a/drivers/bluetooth/btmtk.c b/drivers/bluetooth/btmtk.c
index 38ba8f2bd2f9..c30bdf7befc3 100644
--- a/drivers/bluetooth/btmtk.c
@@ -939,8 +985,13 @@ int btmtk_usb_subsys_reset(struct hci_dev *hdev, u32 dev_id)
 	}
 
 	err = btmtk_usb_id_get(hdev, 0x70010200, &val);
+#ifdef CONFIG_IGEL_ADD_SUPPORT_FOR_MT6639
+	if (err < 0 || (!val && dev_id != 0x6639))
+		bt_dev_err(hdev, "Can't get device id, subsys reset fail.");
+#else
 	if (err < 0 || !val)
 		bt_dev_err(hdev, "Can't get device id, subsys reset fail.");
+#endif
 
 	return err;
 }
