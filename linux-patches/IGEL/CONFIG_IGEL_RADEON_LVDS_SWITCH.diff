index 9c8907bc61d9..4a19addb85a0 100644
--- a/drivers/gpu/drm/radeon/radeon_drv.c
@@ -126,6 +129,12 @@ int radeon_gart_size = -1; /* auto */
 int radeon_benchmarking;
 int radeon_testing;
 int radeon_connector_table;
+#ifdef CONFIG_IGEL_RADEON_SPLIT_DVII
+int radeon_split_dvii = 1;
+#endif
+#ifdef CONFIG_IGEL_RADEON_LVDS_SWITCH
+int radeon_lvds = 1;
+#endif
 int radeon_tv = 1;
 int radeon_audio = -1;
 int radeon_disp_priority;
diff --git a/drivers/gpu/drm/radeon/radeon_drv.c b/drivers/gpu/drm/radeon/radeon_drv.c
index 9c8907bc61d9..4a19addb85a0 100644
--- a/drivers/gpu/drm/radeon/radeon_drv.c
@@ -178,6 +195,15 @@ module_param_named(test, radeon_testing, int, 0444);
 MODULE_PARM_DESC(connector_table, "Force connector table");
 module_param_named(connector_table, radeon_connector_table, int, 0444);
 
+#ifdef CONFIG_IGEL_RADEON_SPLIT_DVII
