IGEL_ADD_HW_RFKILL_TO_IDEAPAD
	  With this new module parameters one can influence it a hw rfkill should
	  be used or not. In the past there were several issue if a hw rfkill
	  was expected but not there which caused non working WLAN issues.
	  There was already a mainline change which removed the blacklist approach
	  and added a whitelist one but with this one can influence the behaviour
	  without the need to rebuild the kernel.

	  Source: IGEL
diff --git a/drivers/platform/x86/lenovo/ideapad-laptop.c b/drivers/platform/x86/lenovo/ideapad-laptop.c
index fcebfbaf0460..8112d27e3b2a 100644
--- a/drivers/platform/x86/lenovo/ideapad-laptop.c
@@ -194,6 +194,18 @@ struct ideapad_private {
 	} fn_lock;
 };
 
+#ifdef CONFIG_IGEL_ADD_HW_RFKILL_TO_IDEAPAD
+/* gottwald@igel.com Make it possible to disable hardware rfkill switch usage */
+
+static bool no_hw_rfkill;
+module_param(no_hw_rfkill, bool, 0444);
+MODULE_PARM_DESC(no_hw_rfkill, "Disable usage of hardware rfkill switch.");
+
+static bool hw_rfkill = 0;
+module_param(hw_rfkill, bool, 0444);
+MODULE_PARM_DESC(hw_rfkill, "Enable usage of hardware rfkill switch.");
+#endif
+
 static bool no_bt_rfkill;
 module_param(no_bt_rfkill, bool, 0444);
 MODULE_PARM_DESC(no_bt_rfkill, "No rfkill for bluetooth.");
diff --git a/drivers/platform/x86/lenovo/ideapad-laptop.c b/drivers/platform/x86/lenovo/ideapad-laptop.c
index fcebfbaf0460..8112d27e3b2a 100644
--- a/drivers/platform/x86/lenovo/ideapad-laptop.c
@@ -2087,8 +2099,21 @@ static int ideapad_check_features(struct ideapad_private *priv)
 
 	priv->features.set_fn_lock_led =
 		set_fn_lock_led || dmi_check_system(set_fn_lock_led_list);
+#ifdef CONFIG_IGEL_ADD_HW_RFKILL_TO_IDEAPAD
+	/* gottwald@igel.com Make it possible to enable/disable hardware
+	 * rfkill switch usage with module parameter */
+	if (no_hw_rfkill) {
+		priv->features.hw_rfkill_switch = 0;
+	} else if (hw_rfkill) {
+		priv->features.hw_rfkill_switch = 1;
+	} else {
+		priv->features.hw_rfkill_switch =
+			hw_rfkill_switch || dmi_check_system(hw_rfkill_list);
+	}
+#else
 	priv->features.hw_rfkill_switch =
 		hw_rfkill_switch || dmi_check_system(hw_rfkill_list);
+#endif
 	priv->features.ctrl_ps2_aux_port =
 		ctrl_ps2_aux_port || dmi_check_system(ctrl_ps2_aux_port_list);
 	priv->features.touchpad_ctrl_via_ec = touchpad_ctrl_via_ec;
