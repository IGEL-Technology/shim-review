IGEL_I915_ADD_DISABLE_HDMI_AUDIO_OPTION
	  Make it possible to switch off the support for HDMI audio on i915 driver
	  level as this is sometimes needed to get things running. And also can
	  help debugging if the problem comes from audio.

	  Source: IGEL
diff --git a/drivers/gpu/drm/i915/display/intel_ddi.c b/drivers/gpu/drm/i915/display/intel_ddi.c
index c09aa759f4d4..c4e436a36bfb 100644
--- a/drivers/gpu/drm/i915/display/intel_ddi.c
@@ -34,6 +34,10 @@
 #include <drm/drm_print.h>
 #include <drm/drm_privacy_screen_consumer.h>
 
+#if defined(CONFIG_IGEL_I915_ADD_DISABLE_DP_AUDIO_OPTION) ||\
+    defined(CONFIG_IGEL_I915_ADD_DISABLE_HDMI_AUDIO_OPTION)
+#include "i915_drv.h"
+#endif
 #include "i915_reg.h"
 #include "i915_utils.h"
 #include "icl_dsi.h"
diff --git a/drivers/gpu/drm/i915/display/intel_ddi.c b/drivers/gpu/drm/i915/display/intel_ddi.c
index c09aa759f4d4..c4e436a36bfb 100644
--- a/drivers/gpu/drm/i915/display/intel_ddi.c
@@ -4168,6 +4172,9 @@ static void intel_ddi_get_config(struct intel_encoder *encoder,
 {
 	struct intel_display *display = to_intel_display(encoder);
 	enum transcoder cpu_transcoder = pipe_config->cpu_transcoder;
+#if (defined(CONFIG_IGEL_I915_ADD_DISABLE_DP_AUDIO_OPTION) || defined(CONFIG_IGEL_I915_ADD_DISABLE_HDMI_AUDIO_OPTION)) && defined(_I915_PARAMS_H_)
+	bool has_audio = false;
+#endif
 
 	/* XXX: DSI transcoder paranoia */
 	if (drm_WARN_ON(display->drm, transcoder_is_dsi(cpu_transcoder)))
diff --git a/drivers/gpu/drm/i915/display/intel_ddi.c b/drivers/gpu/drm/i915/display/intel_ddi.c
index c09aa759f4d4..c4e436a36bfb 100644
--- a/drivers/gpu/drm/i915/display/intel_ddi.c
@@ -4177,8 +4184,15 @@ static void intel_ddi_get_config(struct intel_encoder *encoder,
 
 	intel_ddi_mso_get_config(encoder, pipe_config);
 
+#if (defined(CONFIG_IGEL_I915_ADD_DISABLE_DP_AUDIO_OPTION) || defined(CONFIG_IGEL_I915_ADD_DISABLE_HDMI_AUDIO_OPTION)) && defined(_I915_PARAMS_H_)
+	has_audio = intel_ddi_is_audio_enabled(display, cpu_transcoder);
+	if ((enum intel_output_type) encoder->compute_output_type == (enum intel_output_type)INTEL_OUTPUT_DP && i915_modparams.disable_dp_audio)
+		has_audio = false;
+	pipe_config->has_audio = has_audio;
+#else
 	pipe_config->has_audio =
 		intel_ddi_is_audio_enabled(display, cpu_transcoder);
+#endif
 
 	if (encoder->type == INTEL_OUTPUT_EDP)
 		intel_edp_fixup_vbt_bpp(encoder, pipe_config->pipe_bpp);
