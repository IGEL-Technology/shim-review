index 0b3ee008523d..3415780d90bd 100644
--- a/drivers/gpu/drm/drm_fb_helper.c
@@ -56,6 +56,21 @@ MODULE_PARM_DESC(drm_fbdev_overalloc,
 		 "Overallocation of the fbdev buffer (%) [default="
