IGEL_AMDGPU_CALL_DP_CEC_FUNCS_ONLY_FOR_DP
	  Some devices behave very badly if you use drm_dp_cec... functions on non
	  DisplayPort connectors. So with this option set there is a check before
	  the functions are called if it is really a DisplayPort.

	  Source: IGEL
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index ae10e8365ae1..2a78fa47e95b 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -3826,19 +3850,37 @@ void amdgpu_dm_update_connector_after_detect(
 		aconnector->drm_edid = NULL;
 		if (sink->dc_edid.length == 0) {
 			hdmi_cec_unset_edid(aconnector);
+#ifdef CONFIG_IGEL_AMDGPU_CALL_DP_CEC_FUNCS_ONLY_FOR_DP
+			if (connector->connector_type == DRM_MODE_CONNECTOR_DisplayPort ||
+			    connector->connector_type == DRM_MODE_CONNECTOR_eDP) {
+				if (aconnector->dc_link->aux_mode) {
+					drm_dp_cec_unset_edid(
+						&aconnector->dm_dp_aux.aux);
+				}
+			}
+#else
 			if (aconnector->dc_link->aux_mode) {
 				drm_dp_cec_unset_edid(&aconnector->dm_dp_aux.aux);
 			}
+#endif
 		} else {
 			const struct edid *edid = (const struct edid *)sink->dc_edid.raw_edid;
 
 			aconnector->drm_edid = drm_edid_alloc(edid, sink->dc_edid.length);
 			drm_edid_connector_update(connector, aconnector->drm_edid);
-
 			hdmi_cec_set_edid(aconnector);
+#ifdef CONFIG_IGEL_AMDGPU_CALL_DP_CEC_FUNCS_ONLY_FOR_DP
+			if (connector->connector_type == DRM_MODE_CONNECTOR_DisplayPort ||
+			    connector->connector_type == DRM_MODE_CONNECTOR_eDP) {
+				if (aconnector->dc_link->aux_mode)
+					drm_dp_cec_attach(&aconnector->dm_dp_aux.aux,
+					connector->display_info.source_physical_address);
+			}
+#else
 			if (aconnector->dc_link->aux_mode)
 				drm_dp_cec_attach(&aconnector->dm_dp_aux.aux,
-						  connector->display_info.source_physical_address);
+				connector->display_info.source_physical_address);
+#endif
 		}
 
 		if (!aconnector->timing_requested) {
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index ae10e8365ae1..2a78fa47e95b 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -3853,7 +3895,14 @@ void amdgpu_dm_update_connector_after_detect(
 		update_connector_ext_caps(aconnector);
 	} else {
 		hdmi_cec_unset_edid(aconnector);
+#ifdef CONFIG_IGEL_AMDGPU_CALL_DP_CEC_FUNCS_ONLY_FOR_DP
+		if (connector->connector_type == DRM_MODE_CONNECTOR_DisplayPort ||
+		    connector->connector_type == DRM_MODE_CONNECTOR_eDP) {
+			drm_dp_cec_unset_edid(&aconnector->dm_dp_aux.aux);
+		}
+#else
 		drm_dp_cec_unset_edid(&aconnector->dm_dp_aux.aux);
+#endif
 		amdgpu_dm_update_freesync_caps(connector, NULL);
 		aconnector->num_modes = 0;
 		dc_sink_release(aconnector->dc_sink);
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index ae10e8365ae1..2a78fa47e95b 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -4213,9 +4262,16 @@ static void handle_hpd_rx_irq(void *param)
 			hdcp_handle_cpirq(adev->dm.hdcp_workqueue,  aconnector->base.index);
 	}
 
-	if (dc_link->type != dc_connection_mst_branch)
+	if (dc_link->type != dc_connection_mst_branch) {
+#ifdef CONFIG_IGEL_AMDGPU_CALL_DP_CEC_FUNCS_ONLY_FOR_DP
+		if (connector->connector_type == DRM_MODE_CONNECTOR_DisplayPort ||
+		    connector->connector_type == DRM_MODE_CONNECTOR_eDP) {
+			drm_dp_cec_irq(&aconnector->dm_dp_aux.aux);
+		}
+#else
 		drm_dp_cec_irq(&aconnector->dm_dp_aux.aux);
-
+#endif
+	}
 	mutex_unlock(&aconnector->hpd_lock);
 }
 
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
