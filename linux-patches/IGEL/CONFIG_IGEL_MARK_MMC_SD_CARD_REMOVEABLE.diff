IGEL_MARK_MMC_SD_CARD_REMOVEABLE
	  Our automounter partly rely on the removable flag so if we have a Laptop
	  with MMC cardreader this should be marked as removeable. This is not
	  completely reliable so also internal MMC could be marked as removeable
	  but for this is no real solution.

	  Source: IGEL
diff --git a/drivers/mmc/core/block.c b/drivers/mmc/core/block.c
index 6113bb927946..e8d8642346bf 100644
--- a/drivers/mmc/core/block.c
@@ -2634,6 +2634,11 @@ static struct mmc_blk_data *mmc_blk_alloc_req(struct mmc_card *card,
 	 * messages to tell when the card is present.
 	 */
 
+#ifdef CONFIG_IGEL_MARK_MMC_SD_CARD_REMOVEABLE
+	/* gottwald@igel.com set removable flag if MMC type is SD card (cardreader in laptop for example) */
+	if (card->type == MMC_TYPE_SD_COMBO || card->type == MMC_TYPE_SD || card->type == MMC_TYPE_SDIO)
+		md->disk->flags |= GENHD_FL_REMOVABLE;
+#endif
 	snprintf(md->disk->disk_name, sizeof(md->disk->disk_name),
 		 "mmcblk%u%s", card->host->index, subname ? subname : "");
 
