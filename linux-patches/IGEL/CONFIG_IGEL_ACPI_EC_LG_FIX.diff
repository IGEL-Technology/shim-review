IGEL_ACPI_EC_LG_FIX
	  Some ACPI EC mainline changes leads to non working backlight keys on
	  LG devices so this turns back the changes (only for LG devices).

	  Source: IGEL
diff --git a/drivers/acpi/ec.c b/drivers/acpi/ec.c
index 1f4fc78a124f..f5340053f54b 100644
--- a/drivers/acpi/ec.c
@@ -1532,12 +1532,23 @@ static bool install_gpio_irq_event_handler(struct acpi_ec *ec)
 static int ec_install_handlers(struct acpi_ec *ec, struct acpi_device *device,
 			       bool call_reg)
 {
+#ifdef CONFIG_IGEL_ACPI_EC_LG_FIX
+	acpi_handle scope_handle = ec == first_ec ? ACPI_ROOT_OBJECT : ec->handle;
+	int not_first_ec = dmi_name_in_vendors("LG Electronics");
+#endif
 	acpi_status status;
 
 	acpi_ec_start(ec, false);
 
+#ifdef CONFIG_IGEL_ACPI_EC_LG_FIX
+	if (not_first_ec)
+		scope_handle = ec->handle;
+#endif
+
 	if (!test_bit(EC_FLAGS_EC_HANDLER_INSTALLED, &ec->flags)) {
+#ifndef CONFIG_IGEL_ACPI_EC_LG_FIX
 		acpi_handle scope_handle = ec == first_ec ? ACPI_ROOT_OBJECT : ec->handle;
+#endif
 
 		acpi_ec_enter_noirq(ec);
 		status = acpi_install_address_space_handler_no_reg(scope_handle,
diff --git a/drivers/acpi/ec.c b/drivers/acpi/ec.c
index 1f4fc78a124f..f5340053f54b 100644
--- a/drivers/acpi/ec.c
@@ -1549,6 +1560,9 @@ static int ec_install_handlers(struct acpi_ec *ec, struct acpi_device *device,
 			return -ENODEV;
 		}
 		set_bit(EC_FLAGS_EC_HANDLER_INSTALLED, &ec->flags);
+#ifdef CONFIG_IGEL_ACPI_EC_LG_FIX
+		ec->address_space_handler_holder = scope_handle;
+#endif
 	}
 
 	if (call_reg && !test_bit(EC_FLAGS_EC_REG_CALLED, &ec->flags)) {
diff --git a/drivers/acpi/ec.c b/drivers/acpi/ec.c
index 1f4fc78a124f..f5340053f54b 100644
--- a/drivers/acpi/ec.c
@@ -1604,11 +1618,16 @@ static int ec_install_handlers(struct acpi_ec *ec, struct acpi_device *device,
 
 static void ec_remove_handlers(struct acpi_ec *ec)
 {
+#ifndef CONFIG_IGEL_ACPI_EC_LG_FIX
 	acpi_handle scope_handle = ec == first_ec ? ACPI_ROOT_OBJECT : ec->handle;
-
+#endif
 	if (test_bit(EC_FLAGS_EC_HANDLER_INSTALLED, &ec->flags)) {
 		if (ACPI_FAILURE(acpi_remove_address_space_handler(
+#ifndef CONFIG_IGEL_ACPI_EC_LG_FIX
 						scope_handle,
+#else
+						ec->address_space_handler_holder,
+#endif
 						ACPI_ADR_SPACE_EC,
 						&acpi_ec_space_handler)))
 			pr_err("failed to remove space handler\n");
