IGEL_USB_DISABLE_DISCONNECT
	  Say Y here if you want to be able to block redirect or
	  disconnect events for a given USB device. If setting the sysfs
	  key the device will be protected from redirects or disconnects.
	  Warning this is not a really clean solution and probably need
	  some more work to polish it but it worked for a while now.

	  Source: IGEL
diff --git a/drivers/usb/core/devio.c b/drivers/usb/core/devio.c
index f6ce6e26e0d4..69f98f8558c6 100644
--- a/drivers/usb/core/devio.c
@@ -2355,6 +2355,15 @@ static int proc_ioctl(struct usb_dev_state *ps, struct usbdevfs_ioctl *ctl)
 	/* disconnect kernel driver from interface */
 	case USBDEVFS_DISCONNECT:
 		if (intf->dev.driver) {
+#ifdef CONFIG_IGEL_USB_DISABLE_DISCONNECT
+			struct usb_device       *udev = ps->dev;
+			/* gottwald@igel.com disable disconnect if it was disabled via sysfs */
+			if (udev->disable_disconnect) {
+				printk(KERN_WARNING "Blocked usbdevfs disconnect ioctl for USB device protected by disable_disconnect\n");
+				retval = -EACCES;
+				break;
+			}
+#endif
 			driver = to_usb_driver(intf->dev.driver);
 			dev_dbg(&intf->dev, "disconnect by usbfs\n");
 			usb_driver_release_interface(driver, intf);
