IGEL_REPLACE_UNKNOWN_BATTERY_STATE_WITH_NOT_CHARGING
	  When the battery is neither charging or discharging and is not full,
	  "not-charging" is a useful status description for the case in general.
	  Currently this state is set as "unknown" by default, expect when this is
	  explicitly replaced with "not-charging" on a per device or per vendor
	  basis.

	  Source: IGEL
diff --git a/drivers/acpi/battery.c b/drivers/acpi/battery.c
index 8196c17b5a97..703a7ac5bcbb 100644
--- a/drivers/acpi/battery.c
@@ -52,6 +52,9 @@ MODULE_LICENSE("GPL");
 static int battery_bix_broken_package;
 static int battery_notification_delay_ms;
 static int battery_ac_is_broken;
+#ifndef CONFIG_IGEL_REPLACE_UNKNOWN_BATTERY_STATE_WITH_NOT_CHARGING
+static int battery_quirk_notcharging;
+#endif
 static unsigned int cache_time = 1000;
 module_param(cache_time, uint, 0644);
 MODULE_PARM_DESC(cache_time, "cache time in milliseconds");
diff --git a/drivers/acpi/battery.c b/drivers/acpi/battery.c
index 8196c17b5a97..703a7ac5bcbb 100644
--- a/drivers/acpi/battery.c
@@ -224,8 +227,15 @@ static int acpi_battery_get_property(struct power_supply *psy,
 			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
 		else if (acpi_battery_is_charged(battery))
 			val->intval = POWER_SUPPLY_STATUS_FULL;
+#ifndef CONFIG_IGEL_REPLACE_UNKNOWN_BATTERY_STATE_WITH_NOT_CHARGING
+		else if (battery_quirk_notcharging)
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		else
+			val->intval = POWER_SUPPLY_STATUS_UNKNOWN;
+#else
 		else
 			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+#endif
 		break;
 	case POWER_SUPPLY_PROP_PRESENT:
 		val->intval = acpi_battery_present(battery);
