IGEL_I915_WYSE_3040_DP_QUIRK
	  Added a quirk in the i915 driver to do not use DPMS with DisplayPort on
	  Dell Wyse 3040 device. If using DPMS off some monitors will not wake up
	  again as the i915 driver would not recognize the monitor afterwards.

	  Source: IGEL
diff --git a/drivers/gpu/drm/i915/display/intel_quirks.c b/drivers/gpu/drm/i915/display/intel_quirks.c
index 1abbdd426e58..a07e7d5217d9 100644
--- a/drivers/gpu/drm/i915/display/intel_quirks.c
@@ -10,6 +10,9 @@
 #include "intel_display_core.h"
 #include "intel_display_types.h"
 #include "intel_quirks.h"
+#ifdef CONFIG_IGEL_I915_WYSE_3040_DP_QUIRK
+#include "i915_drv.h"
+#endif
 
 static void intel_set_quirk(struct intel_display *display, enum intel_quirk_id quirk)
 {
diff --git a/drivers/gpu/drm/i915/display/intel_quirks.c b/drivers/gpu/drm/i915/display/intel_quirks.c
index 1abbdd426e58..a07e7d5217d9 100644
--- a/drivers/gpu/drm/i915/display/intel_quirks.c
@@ -66,12 +69,37 @@ static void quirk_increase_ddi_disabled_time(struct intel_display *display)
 	drm_info(display->drm, "Applying Increase DDI Disabled quirk\n");
 }
 
+#ifdef CONFIG_IGEL_APPLE_GMUX
+/*
+ * In some cases, the firmware might not set the lane count to 4 (for example,
+ * when booting in some dual GPU Macs with the dGPU as the default GPU), this
+ * quirk is used to force it as otherwise it might not be possible to compute a
+ * valid link configuration.
+ */
+static void quirk_ddi_a_force_4_lanes(struct intel_display *display)
+{
+	intel_set_quirk(display, QUIRK_DDI_A_FORCE_4_LANES);
+	drm_info(display->drm, "Applying DDI A Forced 4 Lanes quirk\n");
+}
+#endif
+
 static void quirk_no_pps_backlight_power_hook(struct intel_display *display)
 {
 	intel_set_quirk(display, QUIRK_NO_PPS_BACKLIGHT_POWER_HOOK);
 	drm_info(display->drm, "Applying no pps backlight power quirk\n");
 }
 
+#if defined(CONFIG_IGEL_I915_WYSE_3040_DP_QUIRK) && defined(_I915_DRV_H_)
+/* Dell Wyse 3040 doesn't work well with some Dell monitors (E-series).
+ * Workaround this by skipping DP DPMS D3 transition.
+ */
+static void quirk_disable_dp_dpms_d3(struct intel_display *display)
+{
+	intel_set_quirk(display, QUIRK_SKIP_DP_DPMS_D3);
+	DRM_INFO("Applying Wyse 3040 quirk\n");
+}
+#endif
+
 static void quirk_fw_sync_len(struct intel_dp *intel_dp)
 {
