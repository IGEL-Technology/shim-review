IGEL_I915_ADD_M250C_NO_LIMITED_COLOR_RANGE_OPTION
	  We have the problem that the M250 has serious problems with colors on
	  DisplayPort 1 which can be solved with disabling the limited colorspace
	  for this connector (which is wrong but works). Doing so with xrandr is
	  great but will result that the monitor gets a black screen and only come
	  back after some time. So a new i915 module option was added so the
	  settings are done in kernel to avoid the black screen issue and the
	  color problems.

	  Source: IGEL
diff --git a/drivers/gpu/drm/i915/display/intel_dp.c b/drivers/gpu/drm/i915/display/intel_dp.c
index a44fbac1e5e2..ed8d6c06d425 100644
--- a/drivers/gpu/drm/i915/display/intel_dp.c
@@ -51,6 +51,12 @@
 #include <drm/drm_probe_helper.h>
 
 #include "g4x_dp.h"
+#if defined(CONFIG_IGEL_I915_ADD_LIMIT_DP_RATE_OPTION) ||\
+    defined(CONFIG_IGEL_I915_ADD_M250C_NO_LIMITED_COLOR_RANGE_OPTION) ||\
+    defined(CONFIG_IGEL_I915_ADD_DISABLE_DP_AUDIO_OPTION) ||\
+    defined(CONFIG_IGEL_I915_EDP_IS_DP_MODULE_OPTION)
+#include "i915_drv.h"
+#endif
 #include "i915_utils.h"
 #include "intel_alpm.h"
 #include "intel_atomic.h"
diff --git a/drivers/gpu/drm/i915/display/intel_dp.c b/drivers/gpu/drm/i915/display/intel_dp.c
index a44fbac1e5e2..ed8d6c06d425 100644
