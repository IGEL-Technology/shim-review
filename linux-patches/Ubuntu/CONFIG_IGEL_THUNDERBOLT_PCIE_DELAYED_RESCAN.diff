@@ -11,6 +11,9 @@
 #include <linux/delay.h>
 #include <linux/pm_runtime.h>
 #include <linux/platform_data/x86/apple.h>
+#ifdef CONFIG_IGEL_THUNDERBOLT_PCIE_DELAYED_RESCAN
+#include <linux/pci.h>
+#endif /* CONFIG_IGEL_THUNDERBOLT_PCIE_DELAYED_RESCAN */
 
 #include "tb.h"
 #include "tb_regs.h"
