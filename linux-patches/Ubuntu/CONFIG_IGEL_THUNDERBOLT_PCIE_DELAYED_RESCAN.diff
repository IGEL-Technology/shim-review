index 4a94cb406bdf..a9c8abdb88e4 100644
--- a/drivers/thunderbolt/tb.c
@@ -90,6 +104,19 @@ static void tb_dp_resource_unavailable(struct tb *tb, struct tb_port *port,
 static void tb_queue_dp_bandwidth_request(struct tb *tb, u64 route, u8 port,
 					  int retry, unsigned long delay);
 
+#ifdef CONFIG_IGEL_THUNDERBOLT_PCIE_DELAYED_RESCAN
+static void tb_pci_rescan_work_fn(struct work_struct *work)
+{
+	struct tb_pci_rescan_work *rescan_work =
+		container_of(work, typeof(*rescan_work), work.work);
+
+	pci_lock_rescan_remove();
+	pci_rescan_bus(rescan_work->bus);
+	pci_unlock_rescan_remove();
+	kfree(rescan_work);
+}
+#endif /* CONFIG_IGEL_THUNDERBOLT_PCIE_DELAYED_RESCAN */
