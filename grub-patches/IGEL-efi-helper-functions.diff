--- /dev/null
+++ b/grub-core/commands/efi/set_next_boot.c
@@ -0,0 +1,61 @@
+#include <grub/types.h>
+#include <grub/mm.h>
+#include <grub/misc.h>
+#include <grub/normal.h>
+#include <grub/charset.h>
+#include <grub/efi/api.h>
+#include <grub/efi/efi.h>
+
+GRUB_MOD_LICENSE ("GPLv3+");
+
+static grub_err_t
+grub_set_next_boot (struct grub_command *cmd __attribute__ ((unused)),
+		    int argc __attribute__ ((unused)),
+		    char **args __attribute__ ((unused)))
+{
+  static grub_guid_t guid = {0x8be4df61, 0x93ca, 0x11d2, {0xaa, 0x0d, 0x00, 0xe0, 0x98, 0x03, 0x2b, 0x8c}};
+  grub_efi_status_t status;
+  grub_uint16_t num;
+  char *p;
+
+  if (argc != 1) {
+    return grub_error (GRUB_ERR_BAD_ARGUMENT, N_("one argument expected"));
+  }
+
+  p = args[0];
+
+  while (*p == '0' && *p != '\0') {
+    p++;
+  }
+
+  if (*p == '\0') {
+    num = 0;
+  } else {
+    num = grub_strtoul(p,NULL,16);
+  }
+
+  status = grub_efi_set_variable_with_attributes("BootNext", &guid, (grub_uint8_t *)&num,
+					sizeof (num), GRUB_EFI_VARIABLE_NON_VOLATILE |
+					GRUB_EFI_VARIABLE_BOOTSERVICE_ACCESS |
+					GRUB_EFI_VARIABLE_RUNTIME_ACCESS);
+  if (status != GRUB_ERR_NONE)
+    return status;
+
+  grub_reboot ();
+
+  return GRUB_ERR_NONE;
+}
+
+static grub_command_t cmd;
+
+GRUB_MOD_INIT(set_next_boot)
+{
+  cmd = grub_register_command ("set_next_boot", grub_set_next_boot, "",
+			       "Set boot next");
+}
+
+GRUB_MOD_FINI(set_next_boot)
+{
+  if (cmd)
+    grub_unregister_command (cmd);
+}
