+grub_efi_status_t
+grub_efi_get_next_variable_name(grub_size_t *name_size,
+				grub_efi_char16_t **name,
+			        grub_guid_t *guid)
+{
+  grub_efi_status_t status;
+  grub_efi_runtime_services_t *r;
+  grub_efi_char16_t *rname;
+
+  if (*name_size == 0)
+    *name_size = 256;
+
+  if (*name == NULL)
+    *name = grub_zalloc(*name_size);
+
+  if (*name == NULL)
+    return GRUB_EFI_OUT_OF_RESOURCES;
+
+  r = grub_efi_system_table->runtime_services;
+
+  status = r->get_next_variable_name (name_size, *name, guid);
+
+  if (status == GRUB_EFI_BUFFER_TOO_SMALL) {
+    rname = grub_zalloc(*name_size);
+    grub_free (*name);
+    if (rname == NULL) {
+      *name = NULL;
+      *name_size = 0;
+      return GRUB_EFI_OUT_OF_RESOURCES;
+    }
+    *name = rname;
+    status = r->get_next_variable_name (name_size, *name, guid);
+  }
+
+  if (status == GRUB_EFI_NOT_FOUND) {
+    grub_free (*name);
+    *name = NULL;
+    *name_size = 0;
+    return status;
+  }
+
+  return GRUB_EFI_SUCCESS;
+}
