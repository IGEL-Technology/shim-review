+};
+
+static grub_err_t
+grub_find_win_boot_id(struct grub_extcmd_context *ctxt,
+		      int argc __attribute__ ((unused)),
+		      char **args __attribute__ ((unused)))
+{
+  struct grub_arg_list *state = ctxt->state;
+  grub_err_t status = GRUB_ERR_NONE;
+  grub_efi_char16_t *name = NULL;
+  grub_guid_t guid = GRUB_EFI_GLOBAL_VARIABLE_GUID;
+  grub_uint8_t *buf = NULL, *bp;
+  char id[12], varname[201], *var;
+  void *efi_var = NULL;
+  grub_size_t efi_var_size = 0;
+  grub_uint16_t i = 0, p = 0, c = 0, found = 0;
+  grub_int32_t maybe = -1;
+
+  if (argc == 1)
+    grub_printf("%s\n", args[0]);
+
+  buf = grub_zalloc(512);
+  if (buf == NULL) {
+    status = grub_error (GRUB_ERR_OUT_OF_MEMORY, N_("out of memory"));
+    return status;
+  }
+
+  id[0] = '\0';
+
+  for (i=0;i<12288;i++) {
+    if (i <= 0xf) {
+      grub_snprintf(varname, 200, "Boot000%x", i);
+    } else if (i <= 0xff) {
+      grub_snprintf(varname, 200, "Boot00%x", i);
+    } else if (i <= 0xfff) {
+      grub_snprintf(varname, 200, "Boot0%x", i);
+    } else {
+      grub_snprintf(varname, 200, "Boot%x", i);
+    }
+    grub_efi_get_variable (varname, &guid, &efi_var_size, &efi_var);
+    if (!efi_var || !efi_var_size)
+    {
+      continue;
+    }
+
+    c=0;
+    var = (char *)efi_var;
+    for (p=0;p<efi_var_size;p++) {
+      if (var[p] == '\0')
+        continue;
+      if (var[p] == '\n')
+        break;
+      buf[c++] = var[p];
+    }
+    buf[c]='\0';
+
+    grub_free(efi_var);
+
+    grub_dprintf("winboot","%s: buf = %s\n", varname, buf);
+    found = 0;
+    bp = buf;
+    while (*bp != '\0' && found == 0 && grub_strlen((char *)bp) >= 20) {
+      if (grub_strncasecmp((char *)bp, "\\EFI\\Microsoft\\Boot\\bootmgfw.efi", 32) == 0) {
+        found = 1;
+        break;
+      } else if (grub_strncasecmp((char *)bp, "Windows Boot Manager", 20) == 0) {
+        maybe = i;
+      }
+      bp++;
+    }
+    if (found != 0) {
+      if (i <= 0xf) {
+        grub_snprintf(id, 11, "000%x", i);
+      } else if (i <= 0xff) {
+        grub_snprintf(id, 11, "00%x", i);
+      } else if (i <= 0xfff) {
+        grub_snprintf(id, 11, "0%x", i);
+      } else {
+        grub_snprintf(id, 11, "%x", i);
+      }
+      grub_dprintf("winboot","%s: windows bootloader found with id %s\n", varname, id);
+      break;
+    }
+    if (maybe != i) {
+      grub_dprintf("winboot","%s: is not a windows bootloader\n", varname);
+    }
+  }
+
+  if (found == 0 && maybe >= 0) {
+    i = maybe;
+    if (i <= 0xf) {
+      grub_snprintf(varname, 200, "Boot000%x", i);
+      grub_snprintf(id, 11, "000%x", i);
+    } else if (i <= 0xff) {
+      grub_snprintf(varname, 200, "Boot00%x", i);
+      grub_snprintf(id, 11, "00%x", i);
+    } else if (i <= 0xfff) {
+      grub_snprintf(varname, 200, "Boot0%x", i);
+      grub_snprintf(id, 11, "0%x", i);
+    } else {
+      grub_snprintf(varname, 200, "Boot%x", i);
+      grub_snprintf(id, 11, "%x", i);
+    }
+    grub_dprintf("winboot","%s: windows bootloader found with id %s\n", varname, id);
+  }
+
+  if (name) {
+    grub_free(name);
+    name = NULL;
+  }
+
+  if (id[0] != '\0') {
+    if (state[0].set) {
+      status = grub_env_set (state[0].arg, id);
+    } else {
+      grub_printf("%s\n", (const char *)id);
+      status = GRUB_ERR_NONE;
+    }
+  }
+
+  return status;
+}
+
+static grub_extcmd_t cmd = NULL;
+
+GRUB_MOD_INIT (find_win_boot_id)
+{
+  cmd = grub_register_extcmd ("find_win_boot_id", grub_find_win_boot_id, 0, N_("[-s ENV_VAR]"),
+ N_("Get boot id from Windows bootloader."), options);
+}
+
+GRUB_MOD_FINI (find_win_boot_id)
+{
+  if (cmd)
+    grub_unregister_extcmd (cmd);
+}
