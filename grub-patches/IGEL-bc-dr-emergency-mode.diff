+ *  but WITHOUT ANY WARRANTY; without even the implied warranty of
+ *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ *  GNU General Public License for more details.
+ *
+ *  You should have received a copy of the GNU General Public License
+ *  along with GRUB.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <grub/file.h>
+#include <grub/env.h>
+#include <grub/mm.h>
+#include <grub/err.h>
+#include <grub/misc.h>
+#include <grub/dl.h>
+#include <grub/command.h>
+#include <grub/disk.h>
+#include <grub/term.h>
+#include <grub/i18n.h>
+/*
+#include <grub/types.h>
+#include <grub/misc.h>
+#include <grub/mm.h>
+#include <grub/err.h>
+#include <grub/device.h>
+#include <grub/term.h>
+#include <grub/partition.h>
+#include <grub/normal.h>
+#include <grub/extcmd.h>
+#include <grub/datetime.h>
+#include <grub/i18n.h>
+#include <grub/net.h>
+
+#include <grub/dl.h>
+#include <grub/file.h>
+#include <grub/disk.h>
+#include <grub/term.h>
+#include <grub/misc.h>
+#include <grub/extcmd.h>
+#include <grub/i18n.h>
+#include <grub/charset.h>
+*/
+
+
+GRUB_MOD_LICENSE ("GPLv3+");
+
+
+static int
+parse_simple_yaml(char *buf)
+{
+    char *line = buf;
+
+    if (line == NULL)
+	return 1;
+
+    while (*line)
+    {
+        char *next = grub_strchr(line, '\n');
+        if (next)
+            *next = '\0';
+
+        /* Skip leading spaces */
+        while (*line == ' ' || *line == '\t')
+            line++;
+
+        /* Skip comments and empty lines */
+        if (*line && *line != '#')
+        {
+            char *colon = grub_strchr(line, ':');
+
+            if (colon)
+            {
+                *colon = '\0';
+
+                char *key = line;
+                char *value = colon + 1;
+
+                while (*value == ' ' || *value == '\t')
+                    value++;
+
+                /* Trim trailing whitespace from key */
+                char *end = key + grub_strlen(key) - 1;
+                while (end > key &&
+                       (*end == ' ' || *end == '\t'))
+                {
+                    *end = '\0';
+                    end--;
+                }
+
+                /* Trim trailing whitespace (incl. CR/LF from CRLF
+                   line endings) from value, so that e.g.
+                   "igel_os_default: 1\r" is stored as "1". */
+                char *vend = value + grub_strlen(value) - 1;
+                while (vend >= value &&
+                       (*vend == ' ' || *vend == '\t' ||
+                        *vend == '\r' || *vend == '\n'))
+                {
+                    *vend = '\0';
+                    vend--;
+                }
+
+                grub_env_set(key, value);
+            }
+        }
+
+        if (!next)
+            break;
+
+        line = next + 1;
+    }
+
+    return 0;
+}
+
+/* Load BOOT.YML and populate GRUB variables */
+static grub_err_t
+yaml_load(const char *filename)
+{
+    grub_file_t file;
+    grub_off_t size = 0;
+    char *buf = NULL;
+    grub_ssize_t len = 0;
+    grub_ssize_t rem = 0;
+    grub_ssize_t read_len = 0;
+    char *buf_p = NULL;
+
+    file = grub_file_open(filename,
+		          GRUB_FILE_TYPE_YAML);
+    if (!file)
+        return grub_errno;
+
+    size = grub_file_size(file);
+
+    buf = grub_malloc(size + 1);
+    if (!buf)
+    {
+        grub_file_close(file);
+        return GRUB_ERR_OUT_OF_MEMORY;
+    }
+
+    /* Read the whole file, handling short reads: grub_file_read() may
+       return fewer bytes than requested, so loop until SIZE bytes have
+       been consumed (or EOF/error is hit). */
+    rem = size;
+    buf_p = buf;
+    while (0 < rem) {
+      read_len = grub_file_read(file, buf_p, rem);
+      if (0 > read_len) {
+        grub_free(buf);
+        grub_file_close(file);
+        return grub_errno;
+      }
+
+      if (0 == read_len) {
+        /* EOF before the expected size was reached. Parse whatever was
+           read so far rather than treating it as an error. */
+        break;
+      }
+
+      if (rem < read_len) {
+        /* Read more than requested, shouldn't ever happen. */
+        grub_free(buf);
+        grub_file_close(file);
+        return GRUB_ERR_READ_ERROR;
+      }
+
+      rem -= read_len;
+      buf_p += read_len;
+    }
+
+    len = buf_p - buf;
+    buf[len] = '\0';
+
+    /* Parse the YAML contents */
+    if (parse_simple_yaml(buf))
+    {
+        grub_free(buf);
+        grub_file_close(file);
+        return GRUB_ERR_OUT_OF_MEMORY;
+    }
+
+    grub_free(buf);
+    grub_file_close(file);
+
+    return GRUB_ERR_NONE;
+}
+
+/* ### Register a GRUB command */
+
+static grub_err_t
+grub_cmd_yamlload(grub_command_t cmd __attribute__((unused)),
+                  int argc,
+                  char **args)
+{
+    if (argc != 1)
+        return grub_error(GRUB_ERR_BAD_ARGUMENT,
+                          "usage: yamlload FILE");
+
+    return yaml_load(args[0]);
+}
+
+static grub_command_t cmd;
+
+GRUB_MOD_INIT(yaml)
+{
+    cmd = grub_register_command(
+        "yamlload",
+        grub_cmd_yamlload,
+        "FILE",
+        "Load YAML variables");
+}
+
+GRUB_MOD_FINI(yaml)
+{
+    grub_unregister_command(cmd);
+}
+
+/*
+This lets you do:
+
+```grub
+insmod yaml
+yamlload ($root)/BOOT.YML
+echo $kernel
+echo $initrd
+```
+*/
