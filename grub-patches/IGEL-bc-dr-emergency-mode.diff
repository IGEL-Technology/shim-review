Index: grub2/grub-core/commands/yaml.c
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ grub2/grub-core/commands/yaml.c	2026-06-30 15:46:30.707974854 +0200
@@ -0,0 +1,237 @@
+/* yaml.c - command to parse a simple yaml file */
+/*
+ *  GRUB  --  GRand Unified Bootloader
+ *  Copyright (C) 2003,2005,2007,2008,2009  Free Software Foundation, Inc.
+ *
